# Режим API: "http" — настоящий бэкенд, "demo" — данные в памяти браузера (без бэкенда и Keycloak)
VITE_API_MODE=http
# Базовый адрес API. Пусто = тот же источник (в dev-режиме Vite проксирует /api на :8080)
VITE_API_BASE=
# Keycloak (используется только в режиме http)
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=mes
VITE_KEYCLOAK_CLIENT=mes-frontend

<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="003-01-create-batches" author="mes">
        <createTable tableName="batches">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="batch_no" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="production_order_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_batches_order"
                             references="production_orders(id)"/>
            </column>
            <column name="qty" type="DECIMAL(12,3)"/>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="operator" type="VARCHAR(255)"/>
            <column name="produced_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="passport_url" type="VARCHAR(500)"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="003-02-create-raw-material-batches" author="mes">
        <createTable tableName="raw_material_batches">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="lot_no" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="material_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="material_code" type="VARCHAR(50)"/>
            <column name="supplier" type="VARCHAR(255)"/>
            <column name="quantity_available" type="DECIMAL(12,3)"/>
            <column name="expiry" type="DATE"/>
        </createTable>
    </changeSet>

</databaseChangeLog>

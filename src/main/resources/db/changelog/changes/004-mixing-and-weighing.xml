<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="004-01-create-mixing-sessions" author="mes">
        <createTable tableName="mixing_sessions">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="batch_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_mixing_sessions_batch"
                             references="batches(id)"/>
            </column>
            <column name="mixer_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="started_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="finished_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>
    </changeSet>

    <changeSet id="004-02-create-weighing-records" author="mes">
        <createTable tableName="weighing_records">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="mixing_session_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_weighing_session"
                             references="mixing_sessions(id)"/>
            </column>
            <column name="recipe_item_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_weighing_recipe_item"
                             references="recipe_items(id)"/>
            </column>
            <column name="raw_material_batch_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_weighing_rm_batch"
                             references="raw_material_batches(id)"/>
            </column>
            <column name="target_qty" type="DECIMAL(12,3)">
                <constraints nullable="false"/>
            </column>
            <column name="actual_qty" type="DECIMAL(12,3)">
                <constraints nullable="false"/>
            </column>
            <column name="deviation" type="DECIMAL(12,3)"/>
            <column name="within_tolerance" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="weighed_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>
    </changeSet>

</databaseChangeLog>

<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="011-01-batch-number-sequence" author="mes">
        <comment>Номера партий выдаёт последовательность БД: уникальны между сервисами и переживают рестарт.</comment>
        <createSequence sequenceName="batch_no_seq" startValue="1" incrementBy="1"/>
    </changeSet>

    <changeSet id="011-02-traceability-index" author="mes">
        <comment>Прослеживаемость вперёд («в каких партиях использован лот») без полного просмотра таблицы.</comment>
        <createIndex tableName="weighing_records" indexName="idx_weighing_records_rm_batch_id">
            <column name="raw_material_batch_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="011-03-optimistic-locking" author="mes">
        <comment>Версия строки для оптимистичной блокировки: двойной confirm не создаст две партии.</comment>
        <addColumn tableName="production_checklists">
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <addColumn tableName="qc_checklists">
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <addColumn tableName="recipes">
            <column name="version_lock" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="011-04-single-active-version" author="mes" dbms="postgresql">
        <comment>Не более одной ACTIVE-версии на код рецептуры и QC-спецификации (защита от гонки при активации).</comment>
        <sql>CREATE UNIQUE INDEX uq_recipes_active_code ON recipes (code) WHERE status = 'ACTIVE'</sql>
        <sql>CREATE UNIQUE INDEX uq_quality_specs_active_code ON quality_specs (code) WHERE status = 'ACTIVE'</sql>
    </changeSet>

    <changeSet id="011-05-file-integrity" author="mes">
        <comment>Контрольная сумма и тип загруженного файла: recognize читает файл из хранилища и сверяет хэш.</comment>
        <addColumn tableName="production_checklists">
            <column name="file_sha256" type="VARCHAR(64)"/>
            <column name="file_content_type" type="VARCHAR(100)"/>
        </addColumn>
        <addColumn tableName="qc_checklists">
            <column name="file_sha256" type="VARCHAR(64)"/>
            <column name="file_content_type" type="VARCHAR(100)"/>
        </addColumn>
        <createIndex tableName="production_checklists" indexName="idx_checklists_file_sha256">
            <column name="file_sha256"/>
        </createIndex>
        <createIndex tableName="qc_checklists" indexName="idx_qc_checklists_file_sha256">
            <column name="file_sha256"/>
        </createIndex>
    </changeSet>

    <changeSet id="011-06-audit-log" author="mes">
        <comment>Журнал изменений: кто, что, значение до и после (ручные правки OCR, переходы статусов).</comment>
        <createTable tableName="audit_log">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="entity_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="entity_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="field" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="old_value" type="VARCHAR(500)"/>
            <column name="new_value" type="VARCHAR(500)"/>
            <column name="changed_by" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="changed_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="audit_log" indexName="idx_audit_log_entity">
            <column name="entity_type"/>
            <column name="entity_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="011-07-outbox" author="mes">
        <comment>Transactional Outbox: событие пишется в ту же транзакцию, что и бизнес-данные, и уходит в Kafka отдельным процессом.</comment>
        <createTable tableName="outbox_events">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="topic" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="event_key" type="VARCHAR(100)"/>
            <column name="event_type" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="payload" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="sent_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="attempts" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="last_error" type="VARCHAR(500)"/>
        </createTable>
        <createIndex tableName="outbox_events" indexName="idx_outbox_created_at">
            <column name="created_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>

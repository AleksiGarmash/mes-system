<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="005-01-create-quality-checks" author="mes">
        <createTable tableName="quality_checks">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="batch_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_qc_batch"
                             references="batches(id)"/>
            </column>
            <column name="parameter" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="expected_value" type="DECIMAL(12,3)"/>
            <column name="measured_value" type="DECIMAL(12,3)"/>
            <column name="result" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="lab_technician" type="VARCHAR(255)"/>
            <column name="checked_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>
    </changeSet>

</databaseChangeLog>

<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="002-01-create-production-orders" author="mes">
        <createTable tableName="production_orders">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="order_no" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="recipe_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_orders_recipe"
                             references="recipes(id)"/>
            </column>
            <column name="planned_qty" type="DECIMAL(12,3)">
                <constraints nullable="false"/>
            </column>
            <column name="actual_qty" type="DECIMAL(12,3)"/>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="mixer_id" type="UUID"/>
            <column name="planned_date" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>

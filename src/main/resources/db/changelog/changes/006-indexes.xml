<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="006-01-create-indexes" author="mes">
        <createIndex tableName="recipes" indexName="idx_recipes_code">
            <column name="code"/>
        </createIndex>
        <createIndex tableName="recipe_items" indexName="idx_recipe_items_recipe_id">
            <column name="recipe_id"/>
        </createIndex>
        <createIndex tableName="production_orders" indexName="idx_orders_status">
            <column name="status"/>
        </createIndex>
        <createIndex tableName="batches" indexName="idx_batches_order_id">
            <column name="production_order_id"/>
        </createIndex>
        <createIndex tableName="batches" indexName="idx_batches_status">
            <column name="status"/>
        </createIndex>
        <createIndex tableName="raw_material_batches" indexName="idx_rm_batches_lot_no">
            <column name="lot_no"/>
        </createIndex>
        <createIndex tableName="mixing_sessions" indexName="idx_mixing_sessions_batch_id">
            <column name="batch_id"/>
        </createIndex>
        <createIndex tableName="weighing_records" indexName="idx_weighing_records_session_id">
            <column name="mixing_session_id"/>
        </createIndex>
        <createIndex tableName="quality_checks" indexName="idx_quality_checks_batch_id">
            <column name="batch_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
